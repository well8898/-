<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
            android:fontFamily="@font/pretendard"
                android:id="@+id/prev"
                android:layout_width="32dp"
                android:layout_height="30dp"
                android:background="@drawable/row"
                android:gravity="center"
                android:maxLines="1"
                android:text="‹"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
            android:fontFamily="@font/pretendard"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="16sp"
                android:gravity="center"
                android:maxLines="1"
                android:text="일정 불러오는 중…"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
            android:fontFamily="@font/pretendard"
                android:id="@+id/next"
                android:layout_width="32dp"
                android:layout_height="30dp"
                android:background="@drawable/row"
                android:gravity="center"
                android:maxLines="1"
                android:text="›"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
            android:fontFamily="@font/pretendard"
                android:id="@+id/refresh"
                android:layout_width="36dp"
                android:layout_marginStart="6dp"
                android:layout_height="30dp"
                android:background="@drawable/row"
                android:gravity="center"
                android:maxLines="1"
                android:text="↻"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:fontFamily="@font/pretendard"
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FF8B95A5"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />
        <TextView
            android:fontFamily="@font/pretendard"
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="앱을 열어 내 위젯 주소를 넣어 주세요"
            android:textColor="#FF8B95A5"
            android:textSize="13sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">
        <TextView
            android:fontFamily="@font/pretendard"
            android:id="@+id/route"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="12sp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/pill_kakao"
            android:gravity="center"
            android:maxLines="1"
            android:text="하루경로 카카오"
            android:textColor="#FF191919"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:fontFamily="@font/pretendard"
            android:id="@+id/route_naver"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="12sp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/pill_naver"
            android:gravity="center"
            android:maxLines="1"
            android:text="하루경로 네이버"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:fontFamily="@font/pretendard"
            android:id="@+id/app"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="12sp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/row"
            android:gravity="center"
            android:maxLines="1"
            android:text="웹앱 열기"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
