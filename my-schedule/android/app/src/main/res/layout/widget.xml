<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯 4×3 — 개편. 맨 위 ‹ 날짜 › (가운데를 누르면 앱), 아래 총 경로 km · ↻ 새로고침 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/sq"
            android:fontFamily="@font/pretendard"
            android:gravity="center"
            android:text="‹"
            android:contentDescription="전날"
            android:textColor="@color/w_btn_ink"
            android:textSize="20sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/head_mid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/pretendard"
                android:gravity="center"
                android:maxLines="1"
                android:text="일정 불러오는 중…"
                android:textColor="@color/w_ink"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/pretendard"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/w_sub"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/sq"
            android:fontFamily="@font/pretendard"
            android:gravity="center"
            android:text="›"
            android:contentDescription="다음 날"
            android:textColor="@color/w_btn_ink"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/pretendard"
            android:gravity="center"
            android:text="앱을 열어 이름을 골라 주세요"
            android:textColor="@color/w_sub"
            android:textSize="13sp" />
    </FrameLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/w_line"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp">
        <TextView
            android:id="@+id/route"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:fontFamily="@font/pretendard"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:text="총 경로"
            android:textColor="@color/w_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/refresh"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/sq"
            android:contentDescription="새로고침"
            android:fontFamily="@font/pretendard"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/w_btn_ink"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/app"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
