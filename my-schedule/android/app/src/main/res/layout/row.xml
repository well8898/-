<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 한 줄: 시간 | 선·점 | 현장명·정보 | 티맵·카카오·네이버 (시안 B) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/time"
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/pretendard"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/w_ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp">
        <ImageView
            android:id="@+id/line_top"
            android:layout_width="2.5dp"
            android:layout_height="10dp"
            android:layout_gravity="center_horizontal|top"
            android:background="@color/w_line" />
        <ImageView
            android:id="@+id/line_bot"
            android:layout_width="2.5dp"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/w_line" />
        <ImageView
            android:id="@+id/dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="7dp"
            android:layout_gravity="center_horizontal|top"
            android:src="@drawable/dot_ring" />
        <ImageView
            android:id="@+id/dot_past"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="7dp"
            android:layout_gravity="center_horizontal|top"
            android:src="@drawable/dot_past"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard"
            android:maxLines="1"
            android:textColor="@color/w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard"
            android:maxLines="1"
            android:textColor="@color/w_sub"
            android:textSize="11.5sp" />
        <TextView
            android:id="@+id/leg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard"
            android:maxLines="2"
            android:textColor="@color/w_sub"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/go"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:autoSizeMaxTextSize="11.5sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/pill"
            android:fontFamily="@font/pretendard"
            android:gravity="center"
            android:maxLines="1"
            android:text="티맵"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/kakao"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:autoSizeMaxTextSize="11.5sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/pill_kakao"
            android:fontFamily="@font/pretendard"
            android:gravity="center"
            android:maxLines="1"
            android:text="카카오"
            android:textColor="#FF191919"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/naver"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:autoSizeMaxTextSize="11.5sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/pill_naver"
            android:fontFamily="@font/pretendard"
            android:gravity="center"
            android:maxLines="1"
            android:text="네이버"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
